const db = require('../../db');

exports.saveSchedule = async (req, res) => {
    const { scheduleName, items } = req.body;

    const userId = req.user.id; 

    if (!items || !Array.isArray(items) || items.length === 0) {
        return res.status(400).json({ error: "Schedule must contain at least one section." });
    }

    try {
        await db.query('BEGIN');

        const scheduleRes = await db.query(
            'INSERT INTO schedule (user_id, schedule_name) VALUES ($1, $2) RETURNING schedule_id',
            [userId, scheduleName || 'New Schedule']
        );
        
        const scheduleId = scheduleRes.rows[0].schedule_id;

        const insertPromises = items.map(item => {
            return db.query(
                `INSERT INTO schedule_items 
                (schedule_id, section_id, start_time, end_time, day_of_week) 
                VALUES ($1, $2, $3, $4, $5)`,
                [scheduleId, item.sectionId, item.startTime, item.endTime, item.dayOfWeek]
            );
        });

        await Promise.all(insertPromises);
        
        await db.query('COMMIT');
        res.status(201).json({ message: 'Schedule saved successfully!', scheduleId });

    } catch (error) {
        await db.query('ROLLBACK');
        console.error('Error saving schedule:', error);
        res.status(500).json({ error: 'Internal server error while saving.' });
    }
};


