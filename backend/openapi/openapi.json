{
  "openapi": "3.0.0",
  "info": {
    "title": "Aggie Course Explorer Backend API",
    "version": "1.0.0",
    "description": "All API Endpoints for Aggie Course Explorer"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/prereqs/{courseId}": {
      "get": {
        "summary": "Returns fully evaluated prerequisite tree for a course",
        "description": "Calculates if prerequisites are met based on preloaded taken/enrolled data and returns a tree structure for the PrereqDiagram component.",
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "description": "The course ID (e.g. ECEN_403)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "RootNode object containing the evaluated prerequisite tree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootNode"
                }
              }
            }
          },
          "404": {
            "description": "Course not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Course \"ECEN_403\" prerequisites not found."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/prereqs/{courseId}/bucket": {
      "get": {
        "summary": "Returns raw prerequisite bucket for a course",
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "description": "The course ID (e.g. ECEN_403)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The raw prerequisite structure (bucket)",
            "content": {
              "application/json": {
                "example": {
                  "bucket": [
                    "MATH151 C",
                    "MATH152 C",
                    "."
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/api/prereqs/{courseId}/check": {
      "post": {
        "summary": "Check if prerequisites are met for a course with custom taken/enrolled data",
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "description": "The course ID (e.g. ECEN_403)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "taken": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "CSCE121 C",
                      "MATH151 B"
                    ]
                  },
                  "enrolled": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "MATH152 C ^"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Boolean status indicating if prerequisites are met",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "satisfied": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/api/courses/getAll": {
      "get": {
        "summary": "Returns list of course IDs",
        "responses": {
          "200": {
            "description": "Array of course IDs (strings)",
            "content": {
              "application/json": {
                "example": [
                  "ACCT_200",
                  "ACCT_209",
                  "ACCT_210",
                  "..."
                ]
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/api/professors/getAll": {
      "get": {
        "summary": "Returns list of professor names",
        "responses": {
          "200": {
            "description": "Array of professor names",
            "content": {
              "application/json": {
                "example": [
                  "John Doe",
                  "Jane Smith",
                  "Aidan P",
                  "..."
                ]
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/health/level1": {
      "get": {
        "summary": "Basic health check",
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "example": {
                  "STATUS": "HEALTHY"
                }
              }
            }
          }
        }
      }
    },
    "/api/planner2/pdf": {
      "post": {
        "summary": "Accept a PDF body (degree plan) and return parsed term course data",
        "requestBody": {
          "required": true,
          "content": {
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parsed degree plan grouped by academic term",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "hours": {
                          "type": "integer"
                        },
                        "title": {
                          "type": "string"
                        },
                        "number": {
                          "type": "integer"
                        },
                        "department": {
                          "type": "string"
                        },
                        "professors": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "info": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "site": {
                                    "type": "string"
                                  },
                                  "debugId": {
                                    "type": "integer"
                                  },
                                  "warning": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "averageGPA": {
                                    "type": "number",
                                    "format": "float",
                                    "nullable": true
                                  },
                                  "debugClass": {
                                    "type": "string"
                                  },
                                  "classRating": {
                                    "type": "string"
                                  },
                                  "averageRating": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "Fall 2024": [
                    {
                      "hours": 3,
                      "title": "GEN CHEM FOR ENGINEERS",
                      "number": 107,
                      "department": "CHEM",
                      "professors": [
                        {
                          "info": {
                            "id": "123456",
                            "name": "NAME",
                            "site": "College Station",
                            "debugId": 1578643,
                            "warning": "Doesn't typically teach Fall",
                            "averageGPA": null,
                            "debugClass": "CHEM_107",
                            "classRating": "3.3",
                            "averageRating": "3.7"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Error parsing or internal"
          }
        }
      }
    },
